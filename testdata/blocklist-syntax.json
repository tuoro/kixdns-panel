    { "line": "||Ads.Example.COM^", "rules": [{ "allow": false, "important": false, "match": "suffix", "value": "ads.example.com" }] },
    { "line": "||example.com^|", "rules": [{ "allow": false, "important": false, "match": "suffix", "value": "example.com" }] },
