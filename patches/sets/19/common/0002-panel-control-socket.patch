+#[cfg(unix)]
+fn append_map(
+    output: &mut String,
+    name: &str,
+    map: &DashMap<Arc<str>, AtomicU64>,
+    labels: &[&str],
+) {
+    let mut rows = map
+        .iter()
+        .map(|entry| {
+            (
+                entry.key().to_string(),
+                entry.value().load(Ordering::Relaxed),
+            )
+        })
+        .collect::<Vec<_>>();
+    rows.sort_by(|left, right| left.0.cmp(&right.0));
+    for (key, value) in rows {
+        let values = key.split('\0').collect::<Vec<_>>();
+        if values.len() != labels.len() {
+            continue;
+        }
+        let pairs = labels
+            .iter()
+            .zip(values)
+            .map(|(label, value)| (*label, value))
+            .collect::<Vec<_>>();
+        labeled_metric(output, name, &pairs, value);
+    }
+}
+
+#[cfg(unix)]
+fn metric(output: &mut String, name: &str, value: impl std::fmt::Display) {
+    use std::fmt::Write;
+    let _ = writeln!(output, "{name} {value}");
+}
+
+#[cfg(unix)]
+fn labeled_metric(
+    output: &mut String,
+    name: &str,
+    labels: &[(&str, &str)],
+    value: impl std::fmt::Display,
+) {
+    use std::fmt::Write;
+    let _ = write!(output, "{name}{{");
+    for (index, (label, label_value)) in labels.iter().enumerate() {
+        if index > 0 {
+            output.push(',');
+        }
+        let _ = write!(output, "{label}=\"{}\"", escape_label(label_value));
+    }
+    let _ = writeln!(output, "}} {value}");
+}
+
+#[cfg(unix)]
+fn escape_label(value: &str) -> String {
+    value
+        .replace('\\', "\\\\")
+        .replace('\n', "\\n")
+        .replace('"', "\\\"")
+}
+
+fn truncate(value: &str, max_length: usize) -> String {
+    value.chars().take(max_length).collect()
+}
+
+fn unix_timestamp() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |duration| duration.as_secs())
+}
