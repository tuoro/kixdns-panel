+#[cfg(unix)]
+async fn validate_config(request: Request<Incoming>) -> Response<Full<Bytes>> {
+    let body = match Limited::new(request.into_body(), MAX_CONFIG_BODY)
+        .collect()
+        .await
+    {
+        Ok(body) => body.to_bytes(),
+        Err(error) => {
+            let message = if error.is::<http_body_util::LengthLimitError>() {
+                "配置不能超过 4 MiB".to_owned()
+            } else {
+                "读取配置请求失败".to_owned()
+            };
+            return json_response(
+                StatusCode::PAYLOAD_TOO_LARGE,
+                error_json("config_body_invalid", &message),
+            );
+        }
+    };
+
+    let result = crate::config::parse_config(std::str::from_utf8(&body).unwrap_or_default())
+        .and_then(crate::matcher::RuntimePipelineConfig::from_config);
+    match result {
+        Ok(config) => {
+            let pipeline_count = config.pipelines.len();
+            let rule_count = config
+                .pipelines
+                .iter()
+                .map(|pipeline| pipeline.rules.len())
+                .sum::<usize>();
+            json_response(
+                StatusCode::OK,
+                json!({
+                    "protocol_version": PROTOCOL_VERSION,
+                    "valid": true,
+                    "pipeline_count": pipeline_count,
+                    "rule_count": rule_count,
+                }),
+            )
+        }
+        Err(error) => json_response(
+            StatusCode::UNPROCESSABLE_ENTITY,
+            error_json(
+                "config_invalid",
+                &truncate(&format!("{error:#}"), MAX_ERROR_LENGTH),
+            ),
+        ),
+    }
+}
