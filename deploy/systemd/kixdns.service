[Unit]
Description=KixDNS Enhanced DNS 服务
Documentation=https://github.com/tuoro/kixdns-panel
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/var/lib/kixdns-panel/bin/kixdns
ConditionPathExists=/etc/kixdns/pipeline.json

[Service]
Type=simple
User=kixdns
Group=kixdns
UMask=0027
# 逐请求的应答记录（dns_response、dns_request_finished）不进系统日志：每个查询一行会淹没运行日志页，
# 还会把客户端 IP 和域名绕过查询统计的脱敏留在日志里。要看逐条请求用面板的查询日志。
# Per-request response records (dns_response, dns_request_finished) stay out of the journal: one line per
# query buries the runtime log page and keeps client IPs and names there, bypassing the statistics anonymization.
Environment=RUST_LOG=info,kixdns::engine::phases=warn
ExecStart=/var/lib/kixdns-panel/bin/kixdns run --config /etc/kixdns/pipeline.json --admin-socket /run/kixdns/admin.sock
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
LimitNOFILE=65536
RuntimeDirectory=kixdns
RuntimeDirectoryMode=0750

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
