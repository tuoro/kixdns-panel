[Unit]
Description=KixDNS Panel 受限服务控制 helper
Documentation=https://github.com/tuoro/kixdns-panel
After=local-fs.target
Before=kixdns-panel.service
ConditionFileIsExecutable=/usr/local/libexec/kixdns-panel-helper

[Service]
Type=simple
User=root
Group=kixdns
RuntimeDirectory=kixdns-panel
RuntimeDirectoryMode=0750
ExecStart=/usr/local/libexec/kixdns-panel-helper --socket /run/kixdns-panel/control.sock --unit kixdns.service --allowed-uid 0
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/run/kixdns-panel
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
