#!/bin/sh /etc/rc.common
# START、STOP、USE_PROCD 由 /etc/rc.common 读取，shellcheck 看不到 / START, STOP and USE_PROCD are read by /etc/rc.common, out of shellcheck's sight
# shellcheck shell=sh disable=SC2034
# KixDNS 面板 —— OpenWrt procd 版本。
# 面板默认按 systemd 语义工作；这里全部通过环境变量改成 procd 语义：
#   服务状态 ← pidfile，日志 ← 日志文件，启停 ← /etc/init.d/kixdns（由 helper 执行）。

START=96
STOP=05
USE_PROCD=1

PORT=5738

# 面板以 root 运行，默认只听 LAN 口当前的 IPv4 地址，不听 0.0.0.0：防火墙一旦配错，WAN 上也打得开面板。
# 要听别的地址（比如 0.0.0.0，或只给本机反向代理用的 127.0.0.1）就写 UCI，升级不会动它：
#   touch /etc/config/kixdns-panel
#   uci set kixdns-panel.main=panel
#   uci set kixdns-panel.main.bind='0.0.0.0:5738'
#   uci commit kixdns-panel && /etc/init.d/kixdns-panel reload
# LAN 还没有地址时（比如 LAN 走 DHCP、开机时还没拿到）先只听 127.0.0.1；LAN 地址一出来、或者变了，
# 下面的 interface 触发器会让面板换到新地址上。
# The panel runs as root, so by default it listens only on the LAN interface's current IPv4 address instead of
# 0.0.0.0: a misconfigured firewall would otherwise open the panel on the WAN. To listen elsewhere (0.0.0.0, or
# 127.0.0.1 for a local reverse proxy only) set the UCI option above, which upgrades leave alone. Until the LAN has
# an address (a DHCP LAN not yet up at boot, say) the panel listens on 127.0.0.1 only; once the LAN address appears or
# changes, the interface trigger below moves the panel onto it.
panel_bind() {
	bind="$(uci -q get kixdns-panel.main.bind)"
	if [ -n "$bind" ]; then
		echo "$bind"
		return
	fi
	# shellcheck source=/dev/null
	. /lib/functions/network.sh
	lan_ip=""
	network_get_ipaddr lan_ip lan
	if [ -n "$lan_ip" ]; then
		echo "$lan_ip:$PORT"
	else
		logger -t kixdns-panel "LAN 还没有 IPv4 地址，面板先只听 127.0.0.1:$PORT / LAN has no IPv4 address yet, listening on 127.0.0.1:$PORT only"
		echo "127.0.0.1:$PORT"
	fi
}

# 查询日志默认放内存（/tmp）：路由器的闪存小，也经不起一直写；重启就清空。要长期保留就指到 U 盘之类的外置存储：
#   uci set kixdns-panel.main.querylog_dir='/mnt/sda1/kixdns-querylog'
#   uci commit kixdns-panel && /etc/init.d/kixdns-panel restart
# 写的目录所在的那一层不存在（比如 U 盘没挂上）时退回内存，免得写到闪存上去
# The query log sits in memory (/tmp) by default: router flash is small and does not stand constant writes; a reboot
# clears it. To keep it, point it at external storage such as a USB drive with the UCI option above. When the directory's
# parent does not exist (a USB drive not mounted, say) it falls back to memory rather than writing to flash
QUERYLOG_DEFAULT=/tmp/kixdns-panel/querylog
querylog_dir() {
	dir="$(uci -q get kixdns-panel.main.querylog_dir)"
	case "$dir" in
		"") ;;
		/*)
			if [ -d "${dir%/*}" ]; then
				echo "$dir"
				return
			fi
			logger -t kixdns-panel "查询日志目录 $dir 的上一层不存在（外置存储没挂上？），这次放内存 / the parent of the query log directory $dir does not exist (external storage not mounted?), using memory this time"
			;;
		*) logger -t kixdns-panel "查询日志目录要写绝对路径：$dir / the query log directory must be an absolute path: $dir" ;;
	esac
	echo "$QUERYLOG_DEFAULT"
}

start_service() {
	mkdir -p /etc/kixdns-panel /etc/kixdns-panel/geo /run/kixdns-panel

	procd_open_instance
	procd_set_param command /usr/bin/kixdns-panel-server
	procd_set_param env \
		KIXDNS_PANEL_BIND="$(panel_bind)" \
		KIXDNS_PANEL_DATABASE=/etc/kixdns-panel/panel.db \
		KIXDNS_QUERYLOG_DIR="$(querylog_dir)" \
		KIXDNS_CONFIG=/etc/kixdns/pipeline.json \
		KIXDNS_CONTROL_SOCKET=/run/kixdns/admin.sock \
		KIXDNS_SERVICE_UNIT=kixdns.service \
		KIXDNS_SERVICE_HELPER_SOCKET=/run/kixdns-panel/control.sock \
		KIXDNS_SERVICE_PIDFILE=/var/run/kixdns.pid \
		KIXDNS_SERVICE_LOG=/var/log/kixdns.log \
		KIXDNS_GEO_DATA=/etc/kixdns-panel/geo \
		KIXDNS_BUILTIN_GEOSITE=/usr/share/kixdns-panel/geo/geosite.json \
		KIXDNS_BINARY=/usr/bin/kixdns \
		KIXDNS_VERSIONS=/etc/kixdns-panel/versions \
		KIXDNS_BUNDLED_METADATA=/etc/kixdns-panel/bundle \
		KIXDNS_GITHUB_TOKEN_FILE=/etc/kixdns-panel/github-token \
		KIXDNS_WEB_ROOT=/usr/share/kixdns-panel/web
	# install.sh 写下的身份：自带内核的来源、提交、发布编号，面板自己的提交和正式版标签。只认这五项；值只能是字母和数字，
	# 正式版标签是 vX.Y.Z
	# The identity install.sh wrote: the bundled kernel's source, commit and release id, the panel's own commit and release
	# tag. Only these five keys; values letters and digits only, the release tag vX.Y.Z
	if [ -f /etc/kixdns-panel/panel.env ]; then
		while IFS='=' read -r key value; do
			case "$key" in
				KIXDNS_PANEL_INSTALLED_RELEASE)
					case "$value" in v[0-9]*.[0-9]*.[0-9]*) ;; *) continue ;; esac
					case "${value#v}" in *[!0-9.]*) continue ;; esac
					;;
				KIXDNS_INSTALLED_SOURCE | KIXDNS_INSTALLED_COMMIT | KIXDNS_INSTALLED_SOURCE_ID | \
					KIXDNS_PANEL_INSTALLED_COMMIT)
					case "$value" in *[!0-9A-Za-z]* | "") continue ;; esac
					;;
				*) continue ;;
			esac
			procd_append_param env "$key=$value"
		done </etc/kixdns-panel/panel.env
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# 改了 UCI 的监听地址、或者 LAN 的地址起来了 / 变了，就 reload：监听地址变了 procd 才重启面板，没变什么都不做
# A change to the UCI listen address, or the LAN address coming up or changing, triggers a reload: procd restarts the
# panel only when the listen address actually changed
service_triggers() {
	procd_add_reload_trigger kixdns-panel
	procd_add_interface_trigger "interface.*" lan /etc/init.d/kixdns-panel reload
}
