#!/bin/sh /etc/rc.common
# USE_PROCD 由 /etc/rc.common 读取，shellcheck 看不到 / USE_PROCD is read by /etc/rc.common, out of shellcheck's sight
# shellcheck shell=sh disable=SC2034
# KixDNS 面板 —— 面板在线更新的一次性 procd 服务。
# 只由服务助手按面板的请求执行 start；不设 START，也就不会开机自启。跑完进程退出、不重启（没有 respawn），再 start 一次
# 就再跑一次，正在跑时 start 什么都不做。它是自己的 procd 实例，更新时安装器停掉面板和服务助手，它照样跑完。
# KixDNS panel: the one-shot procd service for the panel's online update.
# Only the service helper runs start, at the panel's request; there is no START, so it never starts at boot. The process
# exits when done and is not restarted (no respawn); another start runs it again, and a start while it runs does
# nothing. It is a procd instance of its own, so the installer stopping the panel and the helper during the update does
# not stop it.

USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/kixdns-panel-update
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
