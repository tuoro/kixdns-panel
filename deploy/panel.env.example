# 默认监听所有 IPv4 网卡，允许可信内网访问；不要将该端口直接暴露到公网。
KIXDNS_PANEL_BIND=0.0.0.0:5738
KIXDNS_PANEL_DATABASE=/var/lib/kixdns-panel/panel.db
KIXDNS_CONFIG=/etc/kixdns/pipeline.json
KIXDNS_CONTROL_SOCKET=/run/kixdns/admin.sock
KIXDNS_SERVICE_UNIT=kixdns.service
KIXDNS_SERVICE_HELPER_SOCKET=/run/kixdns-panel/control.sock
# 本机诊断会自动采用当前 settings.bind_udp 的地址和端口；非本机地址保持固定。
KIXDNS_DIAGNOSTIC_SERVER=127.0.0.1:53
KIXDNS_BINARY=/var/lib/kixdns-panel/bin/kixdns
KIXDNS_VERSIONS=/var/lib/kixdns-panel/versions
KIXDNS_BUNDLED_METADATA=/var/lib/kixdns-panel/bundle
KIXDNS_GITHUB_TOKEN_FILE=/var/lib/kixdns-panel/github-token
KIXDNS_GEO_DATA=/var/lib/kixdns-panel/geo
KIXDNS_WEB_ROOT=/usr/share/kixdns-panel/web

# GitHub API 元数据请求可在系统页配置 Token；Artifact 下载仍通过 nightly.link。
KIXDNS_UPDATE_REPOSITORY=tuoro/kixdns-panel
KIXDNS_UPDATE_WORKFLOW=build-kixdns.yml
KIXDNS_UPDATE_RELEASE_WORKFLOW=build-kixdns-release.yml
KIXDNS_UPDATE_BRANCH=main
# x86_64 使用 x86_64，ARM64 使用 arm64；安装脚本会自动填写。
KIXDNS_UPDATE_ARTIFACT=kixdns-enhanced-linux-x86_64
# true：面板管理增强版二进制；false：保留外部 KixDNS，仅使用兼容能力。
KIXDNS_MANAGEMENT_ENABLED=true
# 完整安装包复用的 KixDNS Action 提交，由安装脚本填写；不要手工修改。
KIXDNS_INSTALLED_COMMIT=
# 完整安装包自带增强 Artifact 的 GitHub ID，由安装脚本填写。
KIXDNS_INSTALLED_SOURCE_ID=
# 完整安装包的面板提交，由安装脚本填写；用于展示精确构建身份。
KIXDNS_PANEL_INSTALLED_COMMIT=
# 正式面板安装包的 Release 标签；Action 开发包不设置此变量。
# KIXDNS_PANEL_INSTALLED_RELEASE=

# HTTPS 反向代理部署后改为 true，并重启面板。
KIXDNS_PANEL_SECURE_COOKIE=false
# 仅这些代理 CIDR 可以提供 X-Forwarded-For；多个网段用逗号分隔。
KIXDNS_TRUSTED_PROXIES=127.0.0.1/32,::1/128
RUST_LOG=info
